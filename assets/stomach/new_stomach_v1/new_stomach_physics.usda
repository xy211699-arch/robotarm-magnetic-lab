#usda 1.0
(
    defaultPrim = "NewStomach"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "NewStomach" (
    prepend references = @./new_stomach_visual.usd@</new_stomachfinishied>
)
{
    over "geometry"
    {
        over "mesh"
        {
            # Retain the imported textured shell as the visible surface.
            bool doubleSided = true
            uniform token orientation = "rightHanded"
        }

        # Match the validated legacy asset's separate inward collision mesh.
        # Inherit topology and the same local transform without changing the
        # source visual USD or its texture binding.
        def Mesh "CollisionMesh" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            prepend inherits = </NewStomach/geometry/mesh>
        )
        {
            token visibility = "invisible"
            uniform token orientation = "leftHanded"
            bool physics:collisionEnabled = true
            uniform token physics:approximation = "none"
            rel material:binding:physics = </NewStomach/PhysicsMaterial>
        }
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.15
        float physics:restitution = 0
        float physics:staticFriction = 0.2
    }
}
